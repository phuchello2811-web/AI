# Sao chép thành .env để đổi cấu hình (không bắt buộc).

# Địa chỉ Ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Độ dài ngữ cảnh (token). Lớn hơn thì nhớ được đề dài và nhiều lượt sửa hơn nhưng tốn RAM hơn.
OLLAMA_NUM_CTX=8192
# Cổng của server
PORT=8000
# Trang nào được gọi API (mặc định: Live Server cổng 5500–5599)
# CORS_ORIGIN_REGEX=http://(127\.0\.0\.1|localhost):55\d\d
